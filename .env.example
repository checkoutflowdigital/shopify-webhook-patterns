# Copy to .env (git-ignored) and fill in. Never commit real values.

# Webhook signing secret. For app webhooks this is your app's client secret;
# for webhooks created in the Shopify admin it is shown in the admin notifications settings.
SHOPIFY_WEBHOOK_SECRET=

# Only needed by src/reconcile.js (scheduled catch-up through the Admin API).
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10

# Local receiver port (Node defaults to 3000, Python to 8000).
PORT=3000
